# ---------------------------------------------------------------------------
# RepuH MVP — environment
# Copy to `.env.local`. Never commit real values.
# ---------------------------------------------------------------------------

# Required in every environment. Signs session cookies and encrypts provider
# tokens at rest. Generate with: openssl rand -base64 48
REPUH_APP_SECRET=replace-me-with-a-long-random-string

# Public origin of the web app. Used for OAuth redirects, canonical URLs and
# same-origin checks. No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Absolute or relative path to the SQLite file used by the MVP data layer.
# Required for local development. Production should use the Supabase adapter
# described in docs/ARCHITECTURE.md.
REPUH_DATABASE_PATH=./data/repuh.db

# ---------------------------------------------------------------------------
# Development adapter
# ---------------------------------------------------------------------------
# When enabled, /api/integrations/github/demo can seed clearly labelled demo
# evidence so the product can be explored end-to-end without external
# credentials. Never enable in production. Always rendered with a DEMO badge.
REPUH_DEMO_MODE=true

# ---------------------------------------------------------------------------
# GitHub integration (optional — real OAuth + sync)
# Create an OAuth App at https://github.com/settings/developers
# Callback: ${NEXT_PUBLIC_APP_URL}/api/integrations/github/callback
# ---------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional. When set, scheduled syncs are accepted with
# `Authorization: Bearer <token>` from a cron runner.
REPUH_CRON_SECRET=

# ---------------------------------------------------------------------------
# Hedera anchoring (optional)
# Smart contracts: evidence batch roots are submitted to the deployed
# EvidenceAnchor contract (contracts/EvidenceAnchor.sol). Build the artifact with
# `pnpm contracts:build`, deploy with `pnpm contracts:deploy`, then paste the
# printed contract id below. Without it, batches fall back to the consensus
# topic and then to a local commitment that is explicitly not on-chain.
# Consensus service: certificate hashes are submitted to an HCS topic. Create it
# with `pnpm hedera:setup`.
# Create an operator at https://portal.hedera.com, fund it with test HBAR. The
# operator key is never sent to the browser and never logged.
# ---------------------------------------------------------------------------
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
HEDERA_TOPIC_ID=
# Contract id of the deployed EvidenceAnchor contract, e.g. 0.0.1234567
HEDERA_CONTRACT_ID=

# ---------------------------------------------------------------------------
# Developer admin (optional)
# Comma-separated email allowlist for /admin and /api/admin/metrics. An empty
# value disables the surface entirely (every request 404s). Admin is read-only.
# ---------------------------------------------------------------------------
REPUH_ADMIN_EMAILS=

# ---------------------------------------------------------------------------
# Certificate signing (optional)
# Base64 PKCS#8 DER Ed25519 private key. If absent, a key is generated on first
# use and stored in the database; the public half is published at
# /api/certificates/key either way.
# ---------------------------------------------------------------------------
REPUH_CERT_SIGNING_KEY=

# ---------------------------------------------------------------------------
# AI classification (optional)
# The MVP ships a deterministic, rule-based classifier. Provide a key only if
# you wire an LLM adapter; the interface is defined in docs/SCORING.md.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
