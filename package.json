{
  "name": "repuh",
  "version": "0.1.0",
  "private": true,
  "description": "RepuH — an evidence-backed professional identity platform. MVP.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "extension:build": "node scripts/build-extension.mjs",
    "db:seed": "node --import tsx scripts/seed.ts",
    "hedera:setup": "node --env-file-if-exists=.env.local --import tsx scripts/hedera-setup.ts"
  },
  "dependencies": {
    "@designcodeio/threeui": "^1.2.0",
    "@hashgraph/sdk": "2.81.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "better-sqlite3": "13.0.3",
    "clsx": "2.1.1",
    "framer-motion": "^14.9.0",
    "lucide-react": "1.66.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.10.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "0.187.0",
    "esbuild": "0.28.2",
    "eslint": "9.17.0",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "5.7.2"
  }
}
